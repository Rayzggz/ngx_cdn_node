ngx_addon_name=ngx_http_cdn_node_module

NGX_HTTP_CDN_NODE_SRCS="$ngx_addon_dir/src/ngx_http_cdn_node_module.c"

NGX_HTTP_CDN_NODE_DEPS="$ngx_addon_dir/src/ngx_http_cdn_node_module.h"

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=$ngx_addon_name
    ngx_module_incs=
    ngx_module_deps="$NGX_HTTP_CDN_NODE_DEPS"
    ngx_module_srcs="$NGX_HTTP_CDN_NODE_SRCS"
    ngx_module_libs=

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES $ngx_addon_name"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $NGX_HTTP_CDN_NODE_SRCS"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $NGX_HTTP_CDN_NODE_DEPS"
fi
