# vim:set ft=perl ts=4 sw=4 et:

# 配置解析: 指令上下文, header 名合法性, 保留 header

use Test::Nginx::Socket 'no_plan';

repeat_each(1);

no_long_string();
run_tests();

__DATA__

=== TEST 1: minimal valid config
--- http_config
    cdn_node_header X-Node node-1;
--- config
    location = /t {
        return 200 "ok\n";
    }
--- request
GET /t
--- response_body
ok
--- no_error_log
[error]



=== TEST 2: cdn_node_header is not allowed in server context
--- config
    cdn_node_header X-Node node-1;
--- request
GET /t
--- must_die
--- error_log
"cdn_node_header" directive is not allowed here



=== TEST 3: cdn_node_header is not allowed in location context
--- config
    location = /t {
        cdn_node_header X-Node node-1;
    }
--- request
GET /t
--- must_die
--- error_log
"cdn_node_header" directive is not allowed here



=== TEST 4: cdn_node_colo is not allowed in server context
--- config
    cdn_node_colo HKG;
--- request
GET /t
--- must_die
--- error_log
"cdn_node_colo" directive is not allowed here



=== TEST 5: cdn_node_sliver is not allowed in server context
--- config
    cdn_node_sliver 010-tier1;
--- request
GET /t
--- must_die
--- error_log
"cdn_node_sliver" directive is not allowed here



=== TEST 6: cdn_node_header requires exactly two arguments
--- http_config
    cdn_node_header X-Node;
--- request
GET /t
--- must_die
--- error_log
invalid number of arguments in "cdn_node_header" directive



=== TEST 7: empty header name
--- http_config
    cdn_node_header "" value;
--- request
GET /t
--- must_die
--- error_log
empty header name in "cdn_node_header"



=== TEST 8: header name with space
--- http_config
    cdn_node_header "X Node" value;
--- request
GET /t
--- must_die
--- error_log
invalid header name "X Node" in "cdn_node_header"



=== TEST 9: header name with colon
--- http_config
    cdn_node_header "X-Node:" value;
--- request
GET /t
--- must_die
--- error_log
invalid header name "X-Node:" in "cdn_node_header"



=== TEST 10: header name with non-ASCII byte
--- http_config
    cdn_node_header "X-Nödé" value;
--- request
GET /t
--- must_die
--- error_log
invalid header name



=== TEST 11: header name made of all tchar symbols is accepted
--- http_config
    cdn_node_header "X!#$%&'*+-.^_`|~1" sym;
--- config
    location = /t {
        return 200 "ok\n";
    }
--- request
GET /t
--- response_headers
X!#$%&'*+-.^_`|~1: sym
--- response_body
ok
--- no_error_log
[error]



=== TEST 12: reserved header Server
--- http_config
    cdn_node_header Server my-server;
--- request
GET /t
--- must_die
--- error_log
header "Server" is generated by nginx and cannot be set by "cdn_node_header"



